"""Install the local build service without replacing existing profiles."""
import argparse
import json
from pathlib import Path
import plistlib
import shutil
import subprocess
import sys
import os

parser = argparse.ArgumentParser()
parser.add_argument('--no-start', action='store_true')
parser.add_argument('--source-cache', type=Path)
args = parser.parse_args()
repo = Path(__file__).resolve().parent.parent
state = Path.home() / 'Library/Application Support/Zen Personal'
state.mkdir(parents=True, exist_ok=True)
state.chmod(0o700)
config_path = state / 'config.json'
config = json.loads(config_path.read_text()) if config_path.exists() else {}
config['repo'] = str(repo)
if args.source_cache:
    config['sourceCache'] = str(args.source_cache.resolve())
else:
    config.setdefault('sourceCache', str(repo / '.surfer/engine'))
config_path.write_text(json.dumps(config, indent=2) + '\n')
shutil.copy2(repo / 'personal/zen.py', state / 'builder.py')
logs = Path.home() / 'Library/Logs/Zen Personal'
logs.mkdir(parents=True, exist_ok=True)
label = 'app.yosofb.zen-personal.builder'
plist = Path.home() / 'Library/LaunchAgents' / (label + '.plist')
plist.parent.mkdir(parents=True, exist_ok=True)
with plist.open('wb') as handle:
    plistlib.dump({
        'Label': label,
        'ProgramArguments': [sys.executable, '-u', str(state / 'builder.py'), 'watch'],
        'RunAtLoad': True,
        'KeepAlive': True,
        'ThrottleInterval': 60,
        'StandardOutPath': str(logs / 'build.log'),
        'StandardErrorPath': str(logs / 'build.log'),
    }, handle)
subprocess.run(['plutil', '-lint', str(plist)], check=True)
if not args.no_start:
    domain = f'gui/{os.getuid()}'
    subprocess.run(['launchctl', 'bootout', f'{domain}/{label}'],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(['launchctl', 'bootstrap', domain, str(plist)], check=True)
print('Personal build service configured. Existing profiles were preserved.')
